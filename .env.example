# Copy this file to .env.local and fill in real values for your environment.
# Never commit .env.local or any file containing real secrets.

# --- Site ---
# Production domain, used for canonical URLs, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL=https://www.akarshanagold.com

# --- Gold rate provider (see src/lib/goldRate/) ---
# Defaults to the free Gold API if unset. Change this when moving to a
# paid provider or Akarshana's own approved rate feed.
GOLD_PRICE_API_URL=https://api.gold-api.com/price/XAU
# Only needed if the chosen provider requires authentication. The current
# free Gold API endpoint does not.
GOLD_PRICE_API_KEY=

# USD -> INR conversion source (the gold API returns USD per troy ounce).
CURRENCY_API_URL=https://api.frankfurter.dev/v1/latest?from=USD&to=INR
# Last-resort USD->INR rate, used only if the live currency API is
# unreachable AND there is no cached conversion. Not a gold price fallback
# — see src/config/goldRate.ts for how this is used.
GOLD_RATE_FALLBACK_USD_INR=88

# How long a fetched gold rate is cached before the next request re-fetches
# it from the provider. Clamped to 60-300 seconds — see src/config/goldRate.ts.
GOLD_RATE_CACHE_SECONDS=180

# Optional percentage added on top of the raw international spot-converted
# rate above. The free Gold API feed reflects the raw international gold
# price, not a domestic Indian bullion rate — a real Chennai/Tamil Nadu
# quote (jewellers' association, GoodReturns, etc.) runs higher because it
# bakes in import duty, GST and local market premium, none of which are in
# a raw spot conversion. Leave this at 0 to show the raw international
# rate as-is (default). To approximate a domestic quote instead: compare
# today's site rate against a real Chennai rate, and set this to whatever
# percentage closes that gap — it moves with duty/GST changes and market
# conditions, so re-check it periodically rather than setting it once and
# forgetting it. Clamped to 30% max. See src/config/goldRate.ts.
GOLD_RATE_DOMESTIC_PREMIUM_PERCENT=0

# --- Lead form (see src/app/api/lead/route.ts) ---
# Optional: a webhook URL (Slack, CRM inbox, Zapier/Make, etc.) that
# receives every validated lead as a JSON POST. If unset, leads are
# accepted and validated but not forwarded anywhere — wire this up, or
# replace forwardLead() with a database/CRM integration, before launch.
LEAD_WEBHOOK_URL=

# --- Analytics (see src/lib/analytics.ts) ---
# Optional: set this once a GA4 property (or similar) is chosen, and load
# the provider's script in src/app/layout.tsx. trackEvent() no-ops safely
# until then.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
