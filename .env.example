# Copy this file to .env.local and fill in real values for your environment.
# Never commit .env.local or any file containing real secrets.

# --- Site ---
# Production domain, used for canonical URLs, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL=https://www.akarshanagoldcompany.com

# --- Lead form (see src/app/api/lead/route.ts) ---
# Optional: a webhook URL (Slack, CRM inbox, Zapier/Make, etc.) that
# receives every validated lead as a JSON POST. If unset, leads are
# accepted and validated but not forwarded anywhere — wire this up, or
# replace forwardLead() with a database/CRM integration, before launch.
LEAD_WEBHOOK_URL=

# --- Analytics (see src/lib/analytics.ts) ---
# Optional: set this once a GA4 property (or similar) is chosen, and load
# the provider's script in src/app/layout.tsx. trackEvent() no-ops safely
# until then.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google reviews (see src/lib/googlePlaces.ts) ---
# Optional: fetches real reviews from each branch's Google Business Profile
# via the Places API (New) for the homepage ReviewsSection. Requires a
# Google Cloud project with "Places API (New)" enabled and billing linked;
# the key should be restricted to that API (no HTTP-referrer restriction —
# it's only ever called server-side). Leave any of these unset to keep
# showing the placeholder reviews in src/config/reviews.ts instead.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID_POLLACHI=
GOOGLE_PLACE_ID_UDUMALPET=
GOOGLE_PLACE_ID_COIMBATORE=
GOOGLE_PLACE_ID_TIRUPPUR=
