# Copy this file to .env.local and fill in real values for your environment.
# Never commit .env.local or any file containing real secrets.
#
# The database URL is the one exception that also needs to live in a plain
# `.env` file (not just `.env.local`) — Prisma's CLI (used for `db:push`,
# `db:seed`) only auto-loads `.env`, while Next.js itself loads both.

# --- Site ---
# Production domain, used for canonical URLs, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL=https://www.prashwajewels.com

# --- Database (see prisma/schema.prisma) ---
# Local dev: a file-based SQLite database, zero setup required.
#   DATABASE_URL="file:./dev.db"
# Production: point this at a hosted Postgres instance (Vercel Postgres,
# Neon, Supabase, ...) and change `provider = "sqlite"` to `"postgresql"`
# in prisma/schema.prisma — every model is already Postgres-compatible.
DATABASE_URL="file:./dev.db"

# --- Admin panel (see src/lib/adminAuth.ts) ---
# Single-admin login for /admin — there's no multi-user system to manage.
ADMIN_EMAIL=admin@prashwajewels.com
# Preferred: a scrypt "salt:hash" string generated by hashPassword() in
# src/lib/adminAuth.ts (run it once via `npx tsx -e` or a small script).
ADMIN_PASSWORD_HASH=
# Fallback for quick local setup only — plain-text password. Replace with
# ADMIN_PASSWORD_HASH before launch.
ADMIN_PASSWORD=
# Signs the admin session cookie (JWT). Generate with `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# --- Razorpay (see src/lib/razorpay.ts) ---
# Test-mode keys work for development — checkout still runs end-to-end,
# just against Razorpay's sandbox. Leave blank to run checkout in
# "payment not live yet" mode: orders are still captured, but the team
# follows up manually instead of taking an online payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Contact form (see src/lib/actions/contact.ts) ---
# Optional: a webhook URL (Slack, CRM inbox, Zapier/Make, etc.) that
# receives every validated enquiry as a JSON POST. If unset, enquiries are
# accepted and validated but not forwarded anywhere.
CONTACT_WEBHOOK_URL=

# --- Analytics (see src/lib/analytics.ts) ---
# Optional: set this once a GA4 property (or similar) is chosen, and load
# the provider's script in src/app/layout.tsx. trackEvent() no-ops safely
# until then.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
